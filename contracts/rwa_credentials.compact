pragma language_version >= 0.16 && <= 0.23;

import CompactStandardLibrary;

// ============================================================================
// rwa_credentials: inspection / warranty / insurance credentials for RWAz
// ============================================================================
//
// WHAT THIS CONTRACT IS
//   The credential layer for RWAz objects. Where rwa_registry handles
//   identity + ownership + encumbrances, this contract handles the
//   renewable, issuer-stamped credentials that accompany an asset:
//     - Inspection credentials (passed emissions, structural integrity)
//     - Insurance credentials (active policy, coverage type)
//     - Warranty credentials (manufacturer warranty, terms)
//     - Appraisal credentials (valuation by a certified appraiser)
//
// PRIVACY MODEL (ruling #0)
//   On-chain: credential slot exists + is live + expiry epoch.
//   Off-chain: credential content (what was inspected, coverage amount,
//   appraisal value) stays with the holder as a commitment.
//   prove_credential reveals one bit: "this credential is live and matches
//   this content commitment" — nothing else.
//
// ISSUER MODEL
//   Issuers are key commitments. Trust is the verifier's judgment via
//   TrustedIssuerRegistry (TIR). This contract does not re-implement
//   issuer approval — it records who issued what, and verifiers check TIR.
//
// WHAT PLUGS IN
//   rwa_registry  -> object identity + ownership
//   TIR           -> issuer trust (is this inspector certified?)
//   DIDz root     -> the object's DIDz identity (entity type = object)
//   SilentLedger   -> asset verification before orderbook listing
//   equineProData  -> animal inspection credentials (vet records)

// ---------------------------------------------------------------------------
// CREDENTIAL TYPES
// ---------------------------------------------------------------------------

export enum CredentialType {
  INSPECTION,    // 0 — passed inspection, emissions, structural
  INSURANCE,     // 1 — active insurance policy
  WARRANTY,      // 2 — manufacturer warranty
  APPRAISAL      // 3 — certified appraisal / valuation
}

// ---------------------------------------------------------------------------
// DATA STRUCTURES
// ---------------------------------------------------------------------------

struct CredentialSlotInput {
  separator: Bytes<32>;
  objectId: Bytes<32>;
  credType: Uint<8>;
}

struct CredentialRecord {
  contentCommitment: Bytes<32>;
  issuerCommitment: Bytes<32>;
  issuedEpoch: Uint<64>;
  expiryEpoch: Uint<64>;
  revoked: Boolean;
}

// ---------------------------------------------------------------------------
// LEDGER STATE
// ---------------------------------------------------------------------------

// Slot key H("rwaz:cred:v1", objectId, credType) -> credential record
export ledger credentials: Map<Bytes<32>, CredentialRecord>;

// Shared epoch clock
export ledger epoch: Counter;

// ---------------------------------------------------------------------------
// WITNESSES
// ---------------------------------------------------------------------------

witness local_secret_key(): Bytes<32>;

// ---------------------------------------------------------------------------
// KEY DERIVATION
// ---------------------------------------------------------------------------

export circuit derive_public_key(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "midnight:mm:pk:"),
    sk
  ]);
}

circuit caller_public_key(): Bytes<32> {
  return derive_public_key(local_secret_key());
}

// Compute the slot key for a credential
circuit credential_slot(
  object_id: Bytes<32>,
  cred_type: Uint<8>
): Bytes<32> {
  return persistentHash<CredentialSlotInput>(CredentialSlotInput {
    separator: pad(32, "rwaz:cred:v1"),
    objectId: object_id,
    credType: cred_type
  });
}

// ---------------------------------------------------------------------------
// ISSUE: an issuer stamps a credential on an object
// ---------------------------------------------------------------------------

export circuit issue_credential(
  object_id: Bytes<32>,
  cred_type: Uint<8>,
  content_commitment: Bytes<32>,
  expiry_epoch: Uint<64>
): [] {
  const pubObjectId = disclose(object_id);
  const pubCredType = disclose(cred_type);
  const pubContent = disclose(content_commitment);
  const pubExpiry = disclose(expiry_epoch);
  const issuer = disclose(caller_public_key());

  const slot = disclose(credential_slot(pubObjectId, pubCredType));

  // If a live credential exists, only the same issuer can refresh
  assert(
    !credentials.member(slot)
      || credentials.lookup(slot).revoked
      || disclose(credentials.lookup(slot).issuerCommitment) == issuer,
    "Slot held by a different issuer — revoke first"
  );

  const record = CredentialRecord {
    contentCommitment: pubContent,
    issuerCommitment: issuer,
    issuedEpoch: epoch.read(),
    expiryEpoch: pubExpiry,
    revoked: false
  };

  credentials.insert(slot, disclose(record));
}

// ---------------------------------------------------------------------------
// REVOKE: only the issuing issuer can revoke their credential
// ---------------------------------------------------------------------------

export circuit revoke_credential(
  object_id: Bytes<32>,
  cred_type: Uint<8>
): [] {
  const slot = disclose(credential_slot(
    disclose(object_id),
    disclose(cred_type)
  ));

  assert(credentials.member(slot), "Credential not found");

  const record = credentials.lookup(slot);
  assert(!disclose(record.revoked), "Credential already revoked");
  assert(
    disclose(caller_public_key() == record.issuerCommitment),
    "Only the issuing issuer can revoke"
  );

  const updated = CredentialRecord {
    contentCommitment: disclose(record.contentCommitment),
    issuerCommitment: disclose(record.issuerCommitment),
    issuedEpoch: disclose(record.issuedEpoch),
    expiryEpoch: disclose(record.expiryEpoch),
    revoked: true
  };

  credentials.insert(slot, disclose(updated));
}

// ---------------------------------------------------------------------------
// PROVE: the object owner proves a live, unexpired credential
// ---------------------------------------------------------------------------

// The object's current owner proves: "this object has a live, unexpired
// credential of this type matching this content commitment." The verifier
// already holds the claimed commitment off-chain; the chain confirms it.
// NOTE: In v1, we verify the caller is the credential issuer or a known
// owner. Since we don't import rwa_registry's owner map, the caller
// proves they are the issuer (for issuer-side verification) or the
// content matches (for holder-side verification). Cross-contract calls
// will bridge this in v2.
export circuit prove_credential(
  object_id: Bytes<32>,
  cred_type: Uint<8>,
  claimed_content_commitment: Bytes<32>
): [] {
  const pubObjectId = disclose(object_id);
  const pubCredType = disclose(cred_type);
  const slot = disclose(credential_slot(pubObjectId, pubCredType));

  assert(credentials.member(slot), "Credential not found");

  const record = credentials.lookup(slot);
  assert(!disclose(record.revoked), "Credential revoked");
  assert(epoch.read() < disclose(record.expiryEpoch), "Credential expired");
  assert(
    disclose(record.contentCommitment) == disclose(claimed_content_commitment),
    "Content commitment does not match"
  );
}

// ---------------------------------------------------------------------------
// VERIFY: check if a credential is live (read-only, for verifiers)
// ---------------------------------------------------------------------------

export circuit is_credential_live(
  object_id: Bytes<32>,
  cred_type: Uint<8>
): Boolean {
  const slot = disclose(credential_slot(
    disclose(object_id),
    disclose(cred_type)
  ));

  if (!credentials.member(slot)) {
    return false;
  }
  const record = credentials.lookup(slot);
  return !disclose(record.revoked) && epoch.read() < disclose(record.expiryEpoch);
}

// ---------------------------------------------------------------------------
// CLOCK
// ---------------------------------------------------------------------------

export circuit advance_epoch(): [] {
  epoch.increment(1);
}
